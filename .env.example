# ============================================
# Sanity Configuration
# ============================================
# Get these from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only token with read access (for ISR + draft mode)
# Create at https://www.sanity.io/manage > API > Tokens
SANITY_API_READ_TOKEN=your_read_token

# Secret for revalidate webhook (generate any random string)
SANITY_REVALIDATE_SECRET=your_random_secret_here

# ============================================
# Site Configuration
# ============================================
# Used for canonical URLs, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://example.com

# ============================================
# Email (Resend)
# ============================================
# Get from https://resend.com
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=hello@example.com
RESEND_TO_EMAIL=client@example.com

# ============================================
# Analytics (optional)
# ============================================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
